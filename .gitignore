# Environment variables
.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
pip-log.txt
pip-delete-this-directory.txt

# Generated Reports & Charts (Backend Static)
backend/static/reports/*
backend/static/charts/*
!backend/static/reports/.gitkeep
!backend/static/charts/.gitkeep

# plotly.min.js se copia solo al arrancar (mcp_db.py), desde el paquete
# plotly instalado — no se versiona, para que siempre coincida con la
# version realmente instalada en cada entorno.
backend/static/js/*
!backend/static/js/.gitkeep

# Node (Frontend)
frontend/node_modules/
frontend/dist-ssr/
frontend/*.local

# Logs
*.log
log_errores.txt
log_pdf_parsing.txt

# Editor / IDE Configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gemini/
